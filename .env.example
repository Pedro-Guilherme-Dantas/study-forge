# Localhost only. No credential is needed for fixture mode.
APP_MODE=fixture
DATABASE_URL=postgresql+psycopg://studyforge_runtime:studyforge-runtime-local@db:5432/studyforge
GEMINI_API_KEY=
GEMINI_GENERATION_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_BATCH_SIZE=32
SEARCH_API_KEY=
LANGSMITH_TRACING=false
LANGCHAIN_TRACING_V2=false
# Explicit tracing; content capture is a separate opt-in. Keep automatic flags above false.
STUDYFORGE_TRACING=false
# Sends questions, retrieved passages, prompts and answers to LangSmith when true.
STUDYFORGE_TRACE_CONTENT=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=studyforge-demo
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_WORKSPACE_ID=
# Optional Vertex backend; Developer API uses GEMINI_API_KEY.
GEMINI_BACKEND=developer
GEMINI_PROJECT=
GEMINI_LOCATION=
